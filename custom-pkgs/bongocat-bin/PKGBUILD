# 由 arch_lib 维护: vladelaina/BongoCat 官方预构建 tar.gz（C×SDL3×OpenGL 原生运行时）
# AUR 上无对应包（aur bongo-cat 是 ayangweb/BongoCat Tauri fork），故走 custom-pkgs
# 来源: https://github.com/vladelaina/BongoCat
#
# 不直接拼 releases/download URL：GitHub Release 资产刚发布时 CDN/重定向
# 偶发返回 404。这里通过 Releases API 定位 latest 中实际存在的
# linux-x64 tar.gz，再从 asset API 下载，并使用 API 返回的 sha256 digest 校验。

pkgname=bongocat-bin
_pkgname=BongoCat
pkgver=1.11.0
pkgrel=1
pkgdesc="跨平台互动桌宠 BongoCat（C × SDL3 × OpenGL 原生版，官方预构建）"
arch=('x86_64')
url="https://github.com/vladelaina/BongoCat"
license=('LicenseRef-BongoCat' 'LicenseRef-MIT')
depends=('libglvnd' 'curl' 'libx11' 'libxi' 'libxfixes')
makedepends=('jq')
conflicts=()
options=('!strip')
source=()
sha256sums=()

prepare() {
  cd "$srcdir"

  local release_json latest asset_name asset_api digest
  release_json="$(mktemp)"
  trap 'rm -f "$release_json"' RETURN

  curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 \
    -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2026-03-10' \
    'https://api.github.com/repos/vladelaina/BongoCat/releases/latest' \
    -o "$release_json"

  latest="$(jq -r '.tag_name // empty | sub("^v"; "")' "$release_json")"
  if [[ ! "$latest" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Unable to determine latest BongoCat release version" >&2
    return 1
  fi

  asset_name="BongoCat-${latest}-linux-x64.tar.gz"
  asset_api="$(jq -r --arg n "$asset_name" \
    '.assets[]? | select(.name == $n and .state == "uploaded") | .url' \
    "$release_json" | head -n1)"
  digest="$(jq -r --arg n "$asset_name" \
    '.assets[]? | select(.name == $n and .state == "uploaded") | .digest // empty' \
    "$release_json" | head -n1)"

  if [ -z "$asset_api" ]; then
    echo "Latest release v$latest has no uploaded $asset_name asset" >&2
    return 1
  fi
  if [[ ! "$digest" =~ ^sha256:[0-9a-fA-F]{64}$ ]]; then
    echo "Latest release v$latest has no usable SHA-256 digest for $asset_name" >&2
    return 1
  fi

  printf '%s\n' "$latest" > .bongocat-version
  echo "Downloading GitHub release asset: $asset_name"

  # GitHub documents application/octet-stream on the asset API as the binary
  # download path. It may return either 200 (stream) or 302; -L handles both.
  curl -fL --retry 5 --retry-all-errors --retry-delay 2 \
    -H 'Accept: application/octet-stream' \
    -H 'X-GitHub-Api-Version: 2026-03-10' \
    "$asset_api" -o "$asset_name"

  printf '%s  %s\n' "${digest#sha256:}" "$asset_name" | sha256sum -c -
  tar -xzf "$asset_name"
  rm -f "$asset_name"
}

# makepkg 顺序为 prepare() -> pkgver() -> package()，所以 pkgver 必须读取
# prepare 已经实际下载到的 release 版本，不能再次独立查询最新 tag。
pkgver() {
  cat "$srcdir/.bongocat-version"
}

package() {
  local resolved_ver
  resolved_ver="$(cat "$srcdir/.bongocat-version")"
  cd "$srcdir/BongoCat-${resolved_ver}-linux-x64"

  install -d "$pkgdir/usr/lib/bongocat-bin"
  cp -a BongoCat assets "$pkgdir/usr/lib/bongocat-bin/"

  # assets/ 相对路径按运行时约定解析（与可执行文件同目录）。
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/bongocat" <<'WRAPPER'
#!/bin/sh
exec /usr/lib/bongocat-bin/BongoCat "$@"
WRAPPER
  chmod +x "$pkgdir/usr/bin/bongocat"
}
