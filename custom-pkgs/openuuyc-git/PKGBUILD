# Maintainer: stevessr
# Adapted from upstream packaging/aur/openuuyc-git (risent).

pkgname=openuuyc-git
pkgver=1.0.2_beta.5
pkgrel=1
pkgdesc='Third-party UU Remote client (native Linux port, X11 and Wayland)'
arch=('x86_64')
url='https://github.com/stevessr/openuuyc-linux'
license=('custom')
depends=(
  'gcc-libs' 'alsa-lib' 'dbus' 'fuse3' 'libva' 'libglvnd'
  'libx11' 'libxcb' 'libxrandr' 'libxi' 'libxcursor' 'libxfixes'
  'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'vulkan-icd-loader'
  'noto-fonts-cjk' 'gnome-keyring'
)
makedepends=('git' 'rust' 'cmake' 'clang' 'nasm' 'pkgconf' 'openssl')
optdepends=(
  'sdl2-compat: standard gamepad forwarding and rumble'
  'libva-nvidia-driver: NVIDIA VA-API decoding'
  'intel-media-driver: Intel VA-API decoding and encoding'
  'libpulse: desktop audio capture and playback'
  'pipewire: XDG ScreenCast capture on Wayland'
  'xorg-xwayland: display discovery and input fallback in Wayland sessions'
  'xdg-desktop-portal-hyprland: ScreenCast portal fallback on Hyprland'
  'xdg-desktop-portal-gnome: ScreenCast portal on GNOME'
  'xdg-desktop-portal-kde: ScreenCast portal on KDE'
  'vulkan-swrast: software Vulkan for old GPUs and virtual machines'
  'ethtool: remote power-on NIC configuration'
  'librsvg: SVG file-type icons in drag preview images'
)
provides=('openuuyc')
conflicts=('openuuyc' 'openuuyc-bin')
# GCC LTO objects from native crates (ring) cannot be linked by Rust's lld.
# Upstream also explicitly disables LTO in its release profile.
options=('!debug' '!lto')
install=openuuyc-git.install
source=("git+${url}.git#branch=linux-port")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/openuuyc-linux"
  local version
  version="$(awk -F '"' '/^version = / { print $2; exit }' Cargo.toml)"
  [[ -n "$version" ]] || return 1
  printf '%s.r%s.g%s' "${version//-/_}" \
    "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  # Isolate Cargo downloads/configuration from the builder's user config.
  export CARGO_HOME="$srcdir/cargo"
  mkdir -p "$CARGO_HOME"
}

build() {
  cd "$srcdir/openuuyc-linux"
  export CARGO_HOME="$srcdir/cargo"
  cargo build --release --locked --bin OpenUUYC
  # VKMS has its own workspace and lockfile, but shares the output directory.
  (
    cd crates/vkms
    CARGO_TARGET_DIR="$srcdir/openuuyc-linux/target" cargo build --release --locked
  )
}

package() {
  cd "$srcdir/openuuyc-linux"
  install -Dm755 target/release/OpenUUYC "$pkgdir/usr/bin/OpenUUYC"
  install -Dm755 target/release/openuuyc-vkms "$pkgdir/usr/bin/openuuyc-vkms"
  install -Dm644 packaging/linux/openuuyc.desktop \
    "$pkgdir/usr/share/applications/openuuyc.desktop"
  install -Dm644 assets/icon-256.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/openuuyc.png"
  install -Dm644 packaging/linux/60-openuuyc-uinput.rules \
    "$pkgdir/usr/lib/udev/rules.d/60-openuuyc-uinput.rules"
  # Neither the user service nor the privileged socket is enabled by installation.
  install -Dm644 packaging/linux/openuuyc.service \
    "$pkgdir/usr/lib/systemd/user/openuuyc.service"
  install -Dm644 packaging/linux/openuuyc-vkms.socket \
    "$pkgdir/usr/lib/systemd/system/openuuyc-vkms.socket"
  install -Dm644 packaging/linux/openuuyc-vkms.service \
    "$pkgdir/usr/lib/systemd/system/openuuyc-vkms.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES"
  cp -a assets/licenses "$pkgdir/usr/share/licenses/$pkgname/licenses"
}
