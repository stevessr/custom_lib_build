# 由 arch_lib 维护: vladelaina/BongoCat 官方预构建 ZIP / tar.gz（C×SDL3×OpenGL 原生运行时）
# AUR 上无对应包（aur bongo-cat 是 ayangweb/BongoCat Tauri fork），故走 custom-pkgs
# 来源: https://github.com/vladelaina/BongoCat
#
# 不直接拼 releases/download URL：GitHub Release 资产刚发布时 CDN/重定向
# 偶发返回 404。这里通过 Releases API 定位 latest 中实际存在的
# linux-x64 ZIP / tar.gz，再从 asset API 下载，并使用 API 返回的 sha256 digest 校验。

pkgname=bongocat-bin
_pkgname=BongoCat
pkgver=1.11.0
pkgrel=2
pkgdesc="跨平台互动桌宠 BongoCat（C × SDL3 × OpenGL 原生版，官方预构建）"
arch=('x86_64')
url="https://github.com/vladelaina/BongoCat"
license=('LicenseRef-BongoCat' 'LicenseRef-MIT')
depends=('libglvnd' 'curl' 'libx11' 'libxi' 'libxfixes')
makedepends=('jq' 'unzip')
conflicts=()
options=('!strip')
source=()
sha256sums=()

# Layout-independent extraction of the official Linux archive.
_bongocat_unpack() {
  local archive="$1" stage="$2" candidate name runtime binary relative
  local -a matches=()
  rm -rf -- "$stage" || return 1
  mkdir -p "$stage" || return 1
  case "$archive" in
    *.zip) unzip -q "$archive" -d "$stage" || return 1 ;;
    *.tar.gz) tar -xzf "$archive" -C "$stage" || return 1 ;;
    *) return 1 ;;
  esac
  while IFS= read -r -d '' candidate; do
    name="${candidate##*/}"
    case "${name,,}" in
      bongocat|bongo-cat|bongo_cat|bongocat.bin|bongocat.x86_64|bongocat-linux-x64|bongocat-*-linux-x64) ;;
      *) continue ;;
    esac
    # Do not select a Windows executable, document or similarly named asset.
    [[ $(od -An -tx1 -N6 "$candidate" | tr -d ' \n') == 7f454c460201 ]] || continue
    [[ $(od -An -tx1 -j18 -N2 "$candidate" | tr -d ' \n') == 3e00 ]] || continue
    matches+=("$candidate")
  done < <(find "$stage" -type f -print0)
  if (( ${#matches[@]} != 1 )); then
    printf 'Expected one BongoCat Linux x86_64 executable, found %s in %s\n' "${#matches[@]}" "$archive" >&2
    find "$stage" -maxdepth 3 -printf '%P\n' >&2
    return 1
  fi
  binary="${matches[0]}"
  runtime="${binary%/*}"
  if [[ ${runtime##*/} == bin && "$runtime" != "$stage" ]]; then
    runtime="${runtime%/*}"
  fi
  relative="${binary#"$runtime/"}"
  printf '%s\n' "$runtime" > "$stage/.runtime-root" || return 1
  printf '%s\n' "$relative" > "$stage/.runtime-binary" || return 1
}

prepare() {
  cd "$srcdir" || return 1
  rm -f .bongocat-version

  local release_json latest asset_name asset_api digest
  release_json="$(mktemp)"
  trap 'rm -f "$release_json"' RETURN

  curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 \
    -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2026-03-10' \
    'https://api.github.com/repos/vladelaina/BongoCat/releases/latest' \
    -o "$release_json" || return 1

  latest="$(jq -r '.tag_name // empty | sub("^v"; "")' "$release_json")"
  if [[ ! "$latest" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "Unable to determine latest BongoCat release version" >&2
    return 1
  fi

  for asset_name in "BongoCat-${latest}-linux-x64.zip" "BongoCat-${latest}-linux-x64.tar.gz"; do
    if jq -e --arg n "$asset_name" '.assets[]? | select(.name == $n and .state == "uploaded" and (.digest // "" | test("^sha256:[0-9a-fA-F]{64}$")))' "$release_json" >/dev/null; then
      break
    fi
  done
  asset_api="$(jq -r --arg n "$asset_name" \
    '.assets[]? | select(.name == $n and .state == "uploaded") | .url' \
    "$release_json" | head -n1)"
  digest="$(jq -r --arg n "$asset_name" \
    '.assets[]? | select(.name == $n and .state == "uploaded") | .digest // empty' \
    "$release_json" | head -n1)"

  if [ -z "$asset_api" ]; then
    echo "Latest release v$latest has no uploaded $asset_name asset" >&2
    return 1
  fi
  if [[ ! "$digest" =~ ^sha256:[0-9a-fA-F]{64}$ ]]; then
    echo "Latest release v$latest has no usable SHA-256 digest for $asset_name" >&2
    return 1
  fi

  echo "Downloading GitHub release asset: $asset_name"

  # GitHub documents application/octet-stream on the asset API as the binary
  # download path. It may return either 200 (stream) or 302; -L handles both.
  curl -fL --retry 5 --retry-all-errors --retry-delay 2 \
    -H 'Accept: application/octet-stream' \
    -H 'X-GitHub-Api-Version: 2026-03-10' \
    "$asset_api" -o "$asset_name" || return 1

  printf '%s  %s\n' "${digest#sha256:}" "$asset_name" | sha256sum -c - || return 1
  _bongocat_unpack "$srcdir/$asset_name" "$srcdir/.bongocat-extracted" || return 1
  printf '%s\n' "$latest" > .bongocat-version
  rm -f "$asset_name"
}

# makepkg 顺序为 prepare() -> pkgver() -> package()，所以 pkgver 必须读取
# prepare 已经实际下载到的 release 版本，不能再次独立查询最新 tag。
pkgver() {
  cat "$srcdir/.bongocat-version"
}

package() {
  local stage="$srcdir/.bongocat-extracted" runtime relative target
  runtime=$(cat "$stage/.runtime-root") || return 1
  relative=$(cat "$stage/.runtime-binary") || return 1
  target="$pkgdir/usr/lib/bongocat-bin"
  install -d "$target" "$pkgdir/usr/bin" || return 1
  cp -a "$runtime/." "$target/" || return 1
  rm -f "$target/.runtime-root" "$target/.runtime-binary"
  chmod 755 "$target/$relative" || return 1
  if [[ -d "$runtime/share" ]]; then
    install -d "$pkgdir/usr/share" || return 1
    cp -a "$runtime/share/." "$pkgdir/usr/share/" || return 1
    if [[ -f "$pkgdir/usr/share/applications/bongo-cat.desktop" ]]; then
      sed -i -E 's/^Exec=(BongoCat|bongo-cat|bongo_cat)([[:space:]]|$)/Exec=bongocat\2/I' "$pkgdir/usr/share/applications/bongo-cat.desktop"
    fi
  fi
  printf '#!/bin/sh\nexec /usr/lib/bongocat-bin/%s "$@"\n' "$relative" > "$pkgdir/usr/bin/bongocat" || return 1
  chmod 755 "$pkgdir/usr/bin/bongocat"
}
