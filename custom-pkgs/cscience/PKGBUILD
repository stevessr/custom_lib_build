# cscience — npm 包 @cometix/cscience
# Run Claude Science locally with your own Anthropic API key
# 构建方式：npm pack 下载 + npm install 拉取平台运行时 (bun)

pkgname=cscience
pkgver=0.0.2
pkgrel=1
pkgdesc="Run Claude Science locally with your own Anthropic API key (patched build)"
arch=('x86_64')
url="https://github.com/Haleclipse/cscience"
license=('MIT')
depends=('bun>=1.1.0')
makedepends=('npm')
options=('!strip')
source=()
sha256sums=()

pkgver() {
  npm view @cometix/cscience version
}

prepare() {
  cd "$srcdir"
  npm pack @cometix/cscience --pack-destination "$srcdir"
  tar -xzf cometix-cscience-*.tgz
  rm -f cometix-cscience-*.tgz
  cd package
  npm install --omit=dev --no-audit --no-fund
}

package() {
  cd "$srcdir/package"

  # 安装主包和平台运行时
  install -d "$pkgdir/usr/lib/node_modules/@cometix/cscience"
  cp -a bin package.json README.md "$pkgdir/usr/lib/node_modules/@cometix/cscience/"

  if [ -d node_modules/@cometix/cscience-linux-x64 ]; then
    install -d "$pkgdir/usr/lib/node_modules/@cometix"
    cp -a node_modules/@cometix/cscience-linux-x64 \
      "$pkgdir/usr/lib/node_modules/@cometix/cscience-linux-x64"
  fi

  # 包装入口：cscience.mjs 是 node wrapper，但平台运行时依赖 bun
  # 用 bun 显式运行
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/cscience" <<'WRAPPER'
#!/bin/sh
exec /usr/bin/bun /usr/lib/node_modules/@cometix/cscience/bin/cscience.mjs "$@"
WRAPPER
  chmod +x "$pkgdir/usr/bin/cscience"
}
