# Custom override of the AUR python-colcon-notification recipe (0.3.0).
# Upstream pins a setup.py that imports pkg_resources; setuptools >= 81
# (current Arch, Python 3.14) removed pkg_resources, so the wheel build
# dies with ModuleNotFoundError before the recipe's own version check can
# reject anything. The prepare() below deletes that conditional check.
# Used as a bootstrap dependency of ros2-kilted and built by the normal
# matrix; scripts/pre-build/python-colcon-notification.sh bootstraps
# python-colcon-core first so makepkg -s can resolve on a fresh runner.
pkgname=python-colcon-notification
_name=${pkgname:7}
pkgver=0.3.0
pkgrel=3
pkgdesc="An extension for colcon-core to provide status notifications."
arch=(any)
url="https://pypi.org/project/colcon-notification"
license=('Apache')
depends=('python-colcon-core')
makedepends=('python-setuptools' 'flake8')
# Both sources are fetched into a shared SRCDEST during ROS 2 dependency
# bootstrap. Explicit, package-specific names prevent collisions with other
# packages' generic 0.3.0.tar.gz / v2.2.tar.gz downloads. scspell is only
# used by check() (skipped via --nocheck in the bootstrap path); GitHub
# archive tarballs have non-deterministic gzip metadata, so its sha256
# drifts between CDN edges — SKIP instead of a pinned hash.
source=(
    "colcon-notification-${pkgver}.tar.gz::https://github.com/colcon/colcon-notification/archive/refs/tags/${pkgver}.tar.gz"
    "scspell-v2.2.tar.gz::https://github.com/myint/scspell/archive/refs/tags/v2.2.tar.gz"
)
sha256sums=(
    'f82c6e3bcd558a9fbf4bf0b1cd0dab6a1f50c056b7b4db85c56878797d0489c2'
    'SKIP'
)

prepare() {
    cd ${srcdir}/${_name}-${pkgver}
    # Delete the whole conditional pkg_resources version check (from its
    # `if 'BUILD_DEBIAN_PACKAGE'` line through the matching `sys.exit(1)`),
    # keeping the cmdclass lines that follow. python3 is guaranteed by
    # makepkg's dependency resolution.
    python3 - <<'PY'
p = "setup.py"
lines = open(p).readlines()
out, skip = [], False
for ln in lines:
    if not skip and "'BUILD_DEBIAN_PACKAGE' not in os.environ" in ln:
        skip = True
        continue
    if skip:
        if "sys.exit(1)" in ln:
            skip = False
        continue
    out.append(ln)
open(p, "w").writelines(out)
PY
}

build() {
    cd ${srcdir}/${_name}-${pkgver}
    python -m build --wheel --no-isolation
}

check() {
    cd ${srcdir}/${_name}-${pkgver}
    export PYTHONPATH="${srcdir}/scspell-2.2:${srcdir}/${_name}-${pkgver}"
    ls test*.py | xargs -I {} pytest {}
}

package() {
    cd ${srcdir}/${_name}-${pkgver}
    python -m installer --destdir="${pkgdir}" dist/*.whl
}
