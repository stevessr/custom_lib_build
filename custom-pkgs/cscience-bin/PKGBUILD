# cscience-bin — 原生 Bun 运行时，从 GitHub Release 直接下载
# 来源: https://github.com/Haleclipse/cscience
# 下载: https://github.com/Haleclipse/cscience/releases/download/v$pkgver/cscience-npm-linux-x64-$pkgver.tgz
#
# tarball 结构（npm pack 格式，package/ 前缀，来自上游 CI dist/pkg-linux-x64）:
#   package/
#   ├── bin/claude-science.mjs   # 入口（shebang: #!/usr/bin/env bun）
#   ├── package.json             # version = $pkgver-linux-x64
#   ├── runtime/                 # web-dist, assets, sharp, seccomp...
#   └── templates/byok.env
#
# 需要本地安装 bun（Arch: sudo pacman -S bun）

pkgname=cscience-bin
pkgver=0.0.2
pkgrel=1
pkgdesc="Run Claude Science locally with your own Anthropic API key (native Bun binary)"
arch=('x86_64')
url="https://github.com/Haleclipse/cscience"
license=('MIT')
depends=('bun>=1.1.0')
options=('!strip')
source=()
sha256sums=()

# 动态获取最新版本号（GitHub 标签，如 v0.0.2）
pkgver() {
  git ls-remote --tags https://github.com/Haleclipse/cscience.git \
    | awk '{print $2}' \
    | grep -oP 'v\K[0-9]+\.[0-9]+\.[0-9]+$' \
    | sort -V | tail -1
}

prepare() {
  cd "$srcdir"
  local url="https://github.com/Haleclipse/cscience/releases/download/v${pkgver}/cscience-npm-linux-x64-${pkgver}.tgz"
  echo "Downloading: $url"
  curl -fsSL --retry 3 --retry-delay 2 -o cscience.tgz "$url"
  tar -xzf cscience.tgz   # 解出 package/
  rm -f cscience.tgz
}

package() {
  cd "$srcdir/package"

  install -d "$pkgdir/usr/lib/cscience-bin"
  cp -a bin package.json runtime templates "$pkgdir/usr/lib/cscience-bin/"

  # 入口 wrapper：平台运行时是 Bun SEA（shebang bun），
  # 用系统 bun 显式运行
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/cscience" <<'WRAPPER'
#!/bin/sh
exec /usr/bin/bun /usr/lib/cscience-bin/bin/claude-science.mjs "$@"
WRAPPER
  chmod +x "$pkgdir/usr/bin/cscience"
}